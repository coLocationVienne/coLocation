    "description": "PHP application for managing colocation services",
    "type": "project",
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
